# ── Required ────────────────────────────────────────────────────────────────
# OAuth2 application ("Fighters Guild Portal") created in Fluxer settings.
# Redirect URI to register there:
#   https://chat.example.com/portal/auth/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Random string, >= 32 chars. Signs session + flow cookies.
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: dedicated key for encrypting stored OAuth refresh tokens at rest.
# Defaults to SESSION_SECRET if unset.  openssl rand -hex 32
# TOKEN_ENC_KEY=

# Postgres. Either a full URL...
# DATABASE_URL=postgres://portal:PASSWORD@postgres:5432/portal
# ...or parts (host defaults to `postgres`, the Fluxer DB container's alias):
PGHOST=postgres
PGPORT=5432
PGUSER=portal
PGPASSWORD=
PGDATABASE=portal

# ── Server / origin ────────────────────────────────────────────────────────
PORTAL_PUBLIC_ORIGIN=https://chat.example.com
PORTAL_BASE_PATH=/portal
PORT=3000
NODE_ENV=production
# Reached server-side. The API rejects requests that don't come through Caddy,
# so use the PUBLIC url here too (not http://api:8080). The hairpin is cheap.
FLUXER_API_INTERNAL=https://chat.example.com/api/v1
# The guild whose members are allowed in (snowflake id).
FIGHTERS_GUILD_ID=

# ── Admins ─────────────────────────────────────────────────────────────────
# Fluxer user IDs (comma-separated) with full moderation rights.
PORTAL_ADMIN_IDS=

# ── Portal bot (optional, cross-posts to Fluxer + mission board) ──────────
# A dedicated bot account's token. The bot must be a MEMBER of the guild with
# View Channel + Send Messages + Embed Links + Read Message History in the
# channels below. Invite it (as a guild admin) with:
#   <origin>/api/v1/oauth2/authorize?client_id=<APP_ID>&scope=bot&permissions=84992&guild_id=<GUILD_ID>
PORTAL_BOT_TOKEN=
ANNOUNCE_FORUM_CHANNEL_ID=
ANNOUNCE_EVENTS_CHANNEL_ID=
# Mission board channel. Missions posted on the web cross-post here, and members
# can post `!mission` (see `!mission help`) here to add one to the board.
MISSION_BOARD_CHANNEL_ID=

# Extra bots to show on the Servers page status board ("Label:userId,…").
# The Portal's own bot is always included.
# STATUS_BOTS=SC Tools:1545994940306161664,DJ:1546381591343792128,Crosstalk:1547084826211778560

# Shared bearer token for the Crosstalk bridge to push its health snapshot
# (Fluxer link, Discord link, text + voice bridge) to the status board.
# STATUS_INGEST_TOKEN=

# Source link shown in the page footer (AGPL §13). Point this at your fork if
# you run a modified copy.
# PORTAL_SOURCE_URL=https://github.com/RadSoloCup/fightersguild-portal

# ── Tuning (optional) ──────────────────────────────────────────────────────
# SESSION_TTL_SECONDS=604800
# MEMBERSHIP_RECHECK_SECONDS=900   # re-check membership + resync name/avatar
# PG_POOL_MAX=6
